# ============================================================================
# TradeSense AI — repository hygiene
# ============================================================================

# ---- Node / frontend build output ----
node_modules/
dist/
build/
out/
.next/
coverage/
*.tsbuildinfo
.npm/
test-results/
playwright-report/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*

# ---- Secrets and environment files ----
.env
.env.*
!.env.example
.auth-dev-links.log
*.pem
*.key
*.p12

# ---- IDE / editors ----
.vscode/
.idea/
*.swp
*.swo
*.code-workspace

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Docker / local data volumes ----
docker-volumes/
pgdata/
redisdata/

# ---- Project artifacts ----
# Registry artifacts live only at the repository root; app/ml/models/ is source.
/models/
artifacts/
*.log
logs/

# ---- Private project documentation (kept locally, never published) ----
/README.md
/IMPLEMENTATION-ROADMAP.md
