{
  "name": "tradesense-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Explainable AI forex market intelligence, forecasting, risk analysis and paper trading platform",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "stop": "node scripts/stop.mjs",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "dev:ai": "node scripts/run-in-ai-venv.mjs uvicorn app.main:app --reload --app-dir apps/ai-engine --port 8000",
    "build:packages": "npm run build -w packages/types && npm run build -w packages/validation && npm run build -w packages/config && npm run build -w packages/database",
    "build": "npm run build:packages && npm run build -w apps/api && npm run build -w apps/web",
    "start:api": "npm run start -w apps/api",
    "start:web": "npm run start -w apps/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run build:packages && npm run typecheck -w packages/types && npm run typecheck -w packages/validation && npm run typecheck -w packages/config && npm run typecheck -w packages/database && npm run typecheck -w apps/api && npm run typecheck -w apps/web && tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:ai": "node scripts/run-in-ai-venv.mjs pytest apps/ai-engine",
    "test:e2e": "playwright test --config playwright.config.ts",
    "db:migrate": "node scripts/prisma.mjs migrate dev",
    "db:seed": "node scripts/prisma.mjs db seed",
    "db:reset": "node scripts/prisma.mjs migrate reset --force",
    "db:studio": "node scripts/prisma.mjs studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,json,md,yml,yaml}": "prettier --write",
    "*.{js,cjs,mjs,ts,tsx}": "eslint --fix"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "overrides": {
    "@nestjs/cli": {
      "glob": "14.0.6",
      "minimatch": "11.0.9"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.65.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.5",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.0.0",
    "prisma": "6.12.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
