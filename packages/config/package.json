{
  "name": "@ts/config",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "jest --config ../../jest.config.cjs --runTestsByPath src/env.test.ts src/constants.test.ts src/weights.test.ts",
    "format": "prettier --write src"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14"
  }
}
