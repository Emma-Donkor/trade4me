# ============================================================================
# TradeSense AI — Environment Configuration
# Copy to .env.local and adjust. NEVER commit real credentials.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:4000
AI_SERVICE_URL=http://localhost:8000
# Internal API → AI service token (set a strong value in production)
AI_SERVICE_TOKEN=tradesense-dev-service-token
API_PORT=4000
AI_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Number of trusted reverse-proxy hops used to derive req.ip for rate limiting.
TRUST_PROXY=1

# ----------------------------------------------------------------------------
# Database (PostgreSQL + Prisma)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://tradesense:tradesense@localhost:5433/tradesense?schema=public
DATABASE_POOL_SIZE=10

# ----------------------------------------------------------------------------
# Redis (cache, rate limiting, job queues, realtime)
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6380
REDIS_PREFIX=tradesense:

# ----------------------------------------------------------------------------
# Authentication & sessions
# ----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d
REFRESH_COOKIE_NAME=ts_refresh
REFRESH_COOKIE_SECURE=true
BCRYPT_ROUNDS=12
SESSION_IDLE_TIMEOUT_MINUTES=60

# ----------------------------------------------------------------------------
# Market data providers
# Provider selection: mock | alphavantage | twelvedata
# With MARKET_DATA_PROVIDER=mock no key is required (synthetic dev data).
# ----------------------------------------------------------------------------
MARKET_DATA_PROVIDER=mock
MARKET_API_KEY=
MARKET_BACKUP_PROVIDER=twelvedata
MARKET_BACKUP_API_KEY=
# Per-provider token bucket; 60 accommodates a full sync of the seeded pairs.
MARKET_REQUESTS_PER_MINUTE=60
MARKET_DATA_STALE_THRESHOLD_SECONDS=120

# ----------------------------------------------------------------------------
# News provider
# NEWS_PROVIDER: mock | newsapi | finnhub
# ----------------------------------------------------------------------------
NEWS_PROVIDER=mock
NEWS_API_KEY=
NEWS_POLL_INTERVAL_MINUTES=15

# ----------------------------------------------------------------------------
# Economic calendar provider
# ----------------------------------------------------------------------------
ECONOMIC_CALENDAR_PROVIDER=mock
ECONOMIC_CALENDAR_API_KEY=

# ----------------------------------------------------------------------------
# LLM (explanations, AI assistant — never for raw trade decisions)
# ----------------------------------------------------------------------------
AI_LLM_PROVIDER=openai
AI_API_KEY=
AI_LLM_MODEL=gpt-4o-mini
AI_LLM_MAX_TOKENS=700
AI_LLM_TIMEOUT_MS=15000

# ----------------------------------------------------------------------------
# ML / model registry
# ----------------------------------------------------------------------------
MODEL_REGISTRY_PATH=./models
FEATURE_VERSION=v1.0
DEFAULT_MODEL_NAME=xgboost
DEFAULT_MODEL_VERSION=1.0.0
PREDICTION_THRESHOLD=0.30
WALK_FORWARD_ENABLED=true

# ----------------------------------------------------------------------------
# Background jobs (BullMQ)
# ----------------------------------------------------------------------------
MARKET_SYNC_CRON=0 * * * *          # hourly candle sync
MARKET_INTEGRITY_CRON=0 4 * * *     # daily history gap scan at 04:00
NEWS_INGEST_CRON=*/15 * * * *       # every 15 minutes
FEATURE_JOB_CRON=*/30 * * * *       # feature regeneration
OUTCOME_JOB_CRON=0 * * * *          # hourly prediction outcome evaluation
CLEANUP_CRON=0 3 * * *              # daily cleanup at 03:00
MODEL_EVAL_CRON=0 5 * * *           # daily model retraining/evaluation at 05:00

# ----------------------------------------------------------------------------
# Rate limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# ----------------------------------------------------------------------------
# Risk engine defaults (per-user overrides stored in DB)
# ----------------------------------------------------------------------------
DEFAULT_RISK_PROFILE=MODERATE
DEFAULT_RISK_PER_TRADE_PCT=1.0
MAX_RISK_PER_TRADE_PCT=2.0
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_PCT=3.0
MIN_RISK_REWARD_RATIO=1.5

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------
LOG_LEVEL=info
ENABLE_REQUEST_IDS=true
SENTRY_DSN=

# ----------------------------------------------------------------------------
# Testing
# ----------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://tradesense:tradesense@localhost:5433/tradesense_test
E2E_BASE_URL=http://localhost:3000
